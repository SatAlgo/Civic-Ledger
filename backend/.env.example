# ===== Required =====

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/civic_reporter

# JWT secret — use a long random string in production (openssl rand -base64 48)
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Cloudinary credentials (from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS — frontend origin(s). Comma-separated list. * allows all (dev only)
CORS_ORIGIN=http://localhost:3000

# ===== Optional =====

# Server port (default 5000)
PORT=5000

# Environment: development | production
NODE_ENV=development

# JWT token lifetime (default 7d)
JWT_EXPIRES_IN=7d

# Initial super-admin (used by `npm run seed:admin`)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@civic-ledger.local
SEED_ADMIN_PASSWORD=change-this-strong-password
